# Normalise line endings so a Windows contributor and a Linux CI agree.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.md text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
