# Copy to backend/.env. Every value below has a working default, so the API
# runs with no .env at all — this file documents what to change for deployment.

# ------------------------------------------------------------------ metadata
ENVIRONMENT=development          # development | production | test
SECRET_KEY=change-me-to-a-long-random-string
DOCS_ENABLED=true

# ------------------------------------------------------------------ database
# Default is a local SQLite file, so `uvicorn` works with no setup.
# Postgres (any managed provider) works by swapping the URL — no code change:
DATABASE_URL=sqlite+aiosqlite:///./data/aapaatsathi.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/aapaatsathi
RESET_DATABASE=false             # true drops and recreates the schema on boot

# ---------------------------------------------------------------------- auth
ACCESS_TOKEN_MINUTES=720
REFRESH_TOKEN_MINUTES=20160

# ---------------------------------------------------------------------- CORS
# Comma-separated. Must include the origin your frontend is served from.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------- notifications
# console = default: logs and records every message as SIMULATED, spends nothing.
# twilio / msg91 = real delivery. Missing credentials fall back to console
# with a warning rather than failing at send time.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=AAPATH

# ----------------------------------------------------------- external feeds
# false = deterministic monsoon simulator (reproducible, offline-safe demos).
# true  = poll Open-Meteo for observed + forecast precipitation.
USE_LIVE_WEATHER=false
INGEST_INTERVAL_SECONDS=900

# -------------------------------------------------------------- risk engine
CROWD_UPLIFT_CAP=1.25
ALERT_EVAL_INTERVAL_SECONDS=300
DEDUPE_WINDOW_MINUTES=90

# --------------------------------------------------------------------- demo
SEED_ON_STARTUP=true
