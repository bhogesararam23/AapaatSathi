# Copy to .env and adjust only if the API is not on this machine.
# Everything has a working default, so the app runs without this file.

# Where the dev server proxies /api requests.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Absolute API base for a production build (leave empty to use same-origin).
VITE_API_BASE=

# Show the developer-only scenario panel and API inspector.
VITE_SHOW_DEV_TOOLS=true
